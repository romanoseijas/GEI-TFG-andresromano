"""Modelo MILP de asignacion de tribunales de TFG.

Formulacion
-----------
La version inicial indexaba `x` por (docente, tfg, slot, aula), lo que genera
|D|*|T|*|S|*|A| binarias y no escala con datos reales. Dos cambios lo arreglan:

1. **Se elimina el indice de aula.** Las aulas son homogeneas (el periodo solo
   dice *cuantas* hay), asi que el aula no afecta a la factibilidad: basta con
   limitar a `num_aulas` las defensas simultaneas y repartir las aulas al final.

2. **Los indices son dispersos.** Solo se crean las variables permitidas:
   - `y[t,s]` solo si en el slot s hay al menos k docentes elegibles disponibles
   - `u[d,t,s]` solo si d es elegible para t (no es su tutor y acepta el idioma)
     y ademas esta disponible en s

Variables:
  y[t, s]     -> el TFG t se defiende en el slot s
  u[d, t, s]  -> el docente d evalua el TFG t en el slot s
  z[d]        -> numero de tribunales del docente d

Equidad de carga
----------------
El objetivo original era minimizar `Lmax - Lmin`. Resolverlo como minimax es muy
lento (minutos) porque el solver tiene que romper toda la simetria entre slots.
`solve_balanced` lo resuelve por **epsilon-constraint**: fija la carga de cada
docente a una banda [lo, hi] alrededor de la media y resuelve un problema de
factibilidad, empezando por la banda mas estrecha posible y ensanchandola solo
si no hay solucion. Es equivalente y ~20x mas rapido.
"""

import math

from pyomo.environ import (
    ConcreteModel, Set, Var, Constraint, Objective,
    Binary, NonNegativeIntegers, minimize,
    SolverFactory, value
)

SOLVER_NAMES = ("appsi_highs", "highs", "cbc", "glpk")


def build_indices(data):
    """Calcula los indices dispersos a partir de elegibilidad y disponibilidad."""
    T = list(data["T"])
    D = list(data["D"])
    S = list(data["S"])
    k = int(data.get("tribunal_size", 3))
    eligible = set(data["eligible"])
    avail_slots = data["avail_slots"]

    elegibles_por_tfg = {t: [d for d in D if (d, t) in eligible] for t in T}

    slots_por_tfg = {}
    for t in T:
        candidatos = elegibles_por_tfg[t]
        slots_por_tfg[t] = [
            s for s in S if sum(1 for d in candidatos if s in avail_slots[d]) >= k
        ]
        if not slots_por_tfg[t]:
            raise ValueError(
                f"El TFG '{t}' no tiene ningun slot con {k} evaluadores elegibles "
                f"disponibles a la vez"
            )

    y_index = [(t, s) for t in T for s in slots_por_tfg[t]]
    u_index = [
        (d, t, s)
        for t in T
        for s in slots_por_tfg[t]
        for d in elegibles_por_tfg[t]
        if s in avail_slots[d]
    ]

    return {
        "T": T, "D": D, "S": S, "A": list(data["A"]), "k": k,
        "num_aulas": int(data.get("num_aulas") or len(data["A"]) or 1),
        "load_max": data["load_max"],
        "slots_por_tfg": slots_por_tfg,
        "elegibles_por_tfg": elegibles_por_tfg,
        "y_index": y_index,
        "u_index": u_index,
    }


def build_model(data, load_band=None, idx=None):
    """Construye el modelo. `load_band` = (min, max) de tribunales por docente."""
    idx = idx or build_indices(data)
    T, D, S = idx["T"], idx["D"], idx["S"]
    k, num_aulas = idx["k"], idx["num_aulas"]
    load_max = idx["load_max"]
    slots_por_tfg = idx["slots_por_tfg"]
    y_index, u_index = idx["y_index"], idx["u_index"]

    banda_min, banda_max = load_band if load_band else (0, len(T))

    # Agrupaciones auxiliares para escribir las restricciones sin recorrer
    # productos cartesianos completos
    docentes_por_tfg_slot = {}
    tfgs_por_docente_slot = {}
    asignaciones_por_docente = {}
    for (d, t, s) in u_index:
        docentes_por_tfg_slot.setdefault((t, s), []).append(d)
        tfgs_por_docente_slot.setdefault((d, s), []).append(t)
        asignaciones_por_docente.setdefault(d, []).append((t, s))
    tfgs_por_slot = {}
    for (t, s) in y_index:
        tfgs_por_slot.setdefault(s, []).append(t)

    m = ConcreteModel("TFG_Tribunal_Assignment")

    # 1) Conjuntos
    m.T = Set(initialize=T, ordered=True)
    m.D = Set(initialize=D, ordered=True)
    m.S = Set(initialize=S, ordered=True)
    m.A = Set(initialize=idx["A"], ordered=True)
    m.YIdx = Set(dimen=2, initialize=y_index)
    m.UIdx = Set(dimen=3, initialize=u_index)
    m.DSIdx = Set(dimen=2, initialize=sorted(tfgs_por_docente_slot))

    # 2) Variables de decision
    m.y = Var(m.YIdx, domain=Binary)
    m.u = Var(m.UIdx, domain=Binary)
    m.z = Var(m.D, domain=NonNegativeIntegers)

    # 3) Restricciones
    # R1) Cada TFG se programa exactamente una vez
    def one_schedule_rule(m, t):
        return sum(m.y[t, s] for s in slots_por_tfg[t]) == 1
    m.OneSchedule = Constraint(m.T, rule=one_schedule_rule)

    # R2) Capacidad por slot: no mas defensas simultaneas que aulas
    def room_capacity_rule(m, s):
        if s not in tfgs_por_slot:
            return Constraint.Skip
        return sum(m.y[t, s] for t in tfgs_por_slot[s]) <= num_aulas
    m.RoomCapacity = Constraint(m.S, rule=room_capacity_rule)

    # R3) Tribunal de exactamente k docentes en el slot elegido, y ninguno fuera.
    # Esta igualdad tambien enlaza u con y (si y=0, todos los u de ese slot son 0).
    # La incompatibilidad tutor-TFG, la compatibilidad de idioma y la
    # disponibilidad del docente van incorporadas en el indice de u.
    def tribunal_size_rule(m, t, s):
        return sum(m.u[d, t, s] for d in docentes_por_tfg_slot.get((t, s), [])) == k * m.y[t, s]
    m.TribunalSize = Constraint(m.YIdx, rule=tribunal_size_rule)

    # R4) Un docente no puede evaluar dos TFGs en el mismo slot
    def one_tfg_per_slot_rule(m, d, s):
        tfgs = tfgs_por_docente_slot[(d, s)]
        if len(tfgs) < 2:
            return Constraint.Skip
        return sum(m.u[d, t, s] for t in tfgs) <= 1
    m.OneTFGPerSlot = Constraint(m.DSIdx, rule=one_tfg_per_slot_rule)

    # R5) Definicion de carga
    def load_definition_rule(m, d):
        pares = asignaciones_por_docente.get(d)
        if not pares:
            return m.z[d] == 0
        return m.z[d] == sum(m.u[d, t, s] for (t, s) in pares)
    m.LoadDefinition = Constraint(m.D, rule=load_definition_rule)

    # R6) Limites de carga: max(periodos.max_tribunales) intersectado con la banda
    def load_max_rule(m, d):
        return m.z[d] <= min(banda_max, load_max[d])
    m.LoadMax = Constraint(m.D, rule=load_max_rule)

    # R7) Carga minima: solo exigible a docentes que pueden participar
    def load_min_rule(m, d):
        if banda_min <= 0 or d not in asignaciones_por_docente:
            return Constraint.Skip
        return m.z[d] >= min(banda_min, load_max[d])
    m.LoadMin = Constraint(m.D, rule=load_min_rule)

    # 4) Objetivo. La equidad ya esta impuesta por la banda [banda_min, banda_max],
    # asi que este es un problema de factibilidad pura (mucho mas rapido).
    m.OBJ = Objective(expr=0, sense=minimize)

    m._idx = idx
    m._band = (banda_min, banda_max)
    return m


def target_band(idx):
    """Banda de carga mas estrecha posible alrededor de la media."""
    # Un docente puede participar si aparece en algun indice de u
    participan = {d for (d, _t, _s) in idx["u_index"]}
    utilizables = [d for d in idx["D"] if idx["load_max"][d] > 0 and d in participan]
    if not utilizables:
        raise ValueError(
            "Ningun docente puede participar: revisa la disponibilidad y el "
            "limite de tribunales por docente"
        )
    media = idx["k"] * len(idx["T"]) / len(utilizables)
    return math.floor(media), math.ceil(media)


def solve_balanced(data, time_limit=60, tee=False, max_widen=6):
    """Resuelve buscando la banda de carga mas estrecha que sea factible.

    Devuelve (modelo, resultado, banda). Si ninguna banda funciona, la ultima
    iteracion es un problema sin restriccion de equidad: si tampoco es factible,
    es que los datos no admiten ninguna planificacion.
    """
    idx = build_indices(data)
    lo, hi = target_band(idx)
    tope = max(idx["load_max"].values(), default=len(idx["T"]))

    ultimo = (None, None, None)
    for w in range(max_widen + 1):
        banda = (max(0, lo - w), min(tope, hi + w))
        model = build_model(data, load_band=banda, idx=idx)
        result = solve_model(model, tee=tee, time_limit=time_limit)
        ultimo = (model, result, banda)
        if is_solved(result):
            model.solutions.load_from(result)
            return ultimo
        if banda == (0, tope):
            break
    return ultimo


def solve_model(m, tee=False, time_limit=None):
    last_error = None
    for name in SOLVER_NAMES:
        try:
            solver = SolverFactory(name)
            if solver is None or not solver.available(exception_flag=False):
                continue
            if time_limit:
                _apply_time_limit(solver, name, time_limit)
            return solver.solve(m, tee=tee, load_solutions=False)
        except Exception as exc:
            last_error = exc
    raise RuntimeError(
        "No hay ningun solver MILP disponible (probados: appsi_highs, highs, cbc, glpk). "
        "Instala uno, por ejemplo: pip install highspy"
    ) from last_error


def _apply_time_limit(solver, name, seconds):
    option_key = {
        "appsi_highs": "time_limit",
        "highs": "time_limit",
        "cbc": "seconds",
        "glpk": "tmlim",
    }[name]
    try:
        solver.options[option_key] = seconds
    except Exception:
        pass  # el solver no soporta la opcion; se resuelve sin limite


def is_solved(res):
    if res is None:
        return False
    if str(res.solver.termination_condition).lower() not in (
        "optimal", "feasible", "locallyoptimal", "maxtimelimit"
    ):
        return False
    # Con time_limit puede terminar sin ninguna solucion entera cargada
    return len(getattr(res, "solution", [])) > 0


def extract_solution(m):
    """Devuelve [(tfg, slot, aula, [evaluadores])] repartiendo las aulas por slot."""
    idx = m._idx
    aulas = idx["A"]
    programados = {}
    for t in idx["T"]:
        for s in idx["slots_por_tfg"][t]:
            if value(m.y[t, s]) > 0.5:
                evaluadores = [
                    d for d in idx["elegibles_por_tfg"][t]
                    if (d, t, s) in m.UIdx and value(m.u[d, t, s]) > 0.5
                ]
                programados.setdefault(s, []).append((t, evaluadores))
                break

    asignaciones = []
    for s in sorted(programados):
        for i, (t, evaluadores) in enumerate(programados[s]):
            aula = aulas[i] if i < len(aulas) else f"A{i + 1}"
            asignaciones.append((t, s, aula, evaluadores))
    return asignaciones


def print_solution(m, res):
    print("Status:", res.solver.status)
    print("Termination:", res.solver.termination_condition)

    if not is_solved(res):
        print("No hay solucion factible con los datos actuales.")
        return

    cargas = {d: int(round(value(m.z[d]))) for d in m.D}
    activos = [n for n in cargas.values() if n > 0]
    print(f"Banda de carga={m._band}, min={min(activos or [0])}, max={max(activos or [0])}")

    for t, s, a, evaluadores in extract_solution(m):
        print(f"{t} -> slot={s}, aula={a}, evals={evaluadores}")
